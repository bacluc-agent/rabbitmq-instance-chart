# chartsnap: snapshot_version=v3
---
# Source: rabbitmq-instance/templates/prober-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: rabbitmq-prober-service
  namespace: rabbitmq
  labels:
    app: rabbitmq-prober
spec:
  type: ClusterIP
  selector:
    app: rabbitmq-prober
  ports:
  - name: metrics
    port: 8080
    targetPort: 8080
    protocol: TCP
---
# Source: rabbitmq-instance/templates/prober-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rabbitmq-prober
  namespace: rabbitmq
  labels:
    app: rabbitmq-prober
spec:
  replicas: 1
  minReadySeconds: 30
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
      maxSurge: 25%
  selector:
    matchLabels:
      app: rabbitmq-prober
  template:
    metadata:
      labels:
        app: rabbitmq-prober
    spec:
      containers:
      - name: prober
        image: "ghcr.io/vshn/rabbitmq-instance-chart/prober:0.0.1"
        env:
        - name: RABBITMQ_HOST
          valueFrom:
            secretKeyRef:
              name: rabbitmq-default-user
              key: host
        - name: RABBITMQ_PORT
          valueFrom:
            secretKeyRef:
              name: rabbitmq-default-user
              key: port
        - name: RABBITMQ_USER
          valueFrom:
            secretKeyRef:
              name: rabbitmq-default-user
              key: username
        - name: RABBITMQ_PASSWORD
          valueFrom:
            secretKeyRef:
              name: rabbitmq-default-user
              key: password
        - name: PROBE_INTERVAL
          value: "10"
        - name: METRICS_PORT
          value: "8080"
        - name: RABBITMQ_USE_TLS
          value: "true"
        ports:
        - containerPort: 8080
          name: metrics
        resources:
          limits:
            cpu: 100m
            memory: 128Mi
          requests:
            cpu: 50m
            memory: 64Mi
        livenessProbe:
          httpGet:
            path: /
            port: 8080
        readinessProbe:
          httpGet:
            path: /
            port: 8080
      restartPolicy: Always
---
# Source: rabbitmq-instance/templates/rabbitmq-cluster.yaml
apiVersion: rabbitmq.com/v1beta1
kind: RabbitmqCluster
metadata:
  name: rabbitmq
  namespace: rabbitmq
spec:
  rabbitmq:
    additionalPlugins:
    - rabbitmq_prometheus
    additionalConfig: |
      vm_memory_high_watermark.absolute = 3Gi
  image: docker.io/library/rabbitmq:4.3.6-alpine
  persistence:
    storage: 3Gi
  replicas: 1
  resources:
    limits:
      cpu: "1"
      memory: 3Gi
    requests:
      cpu: "1"
      memory: 3Gi
  service: {}
  override:
    statefulSet:
      spec:
        template:
          spec:
            containers: []
            securityContext: {}
            affinity:
              podAntiAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/component: rabbitmq
                      app.kubernetes.io/name: rabbitmq
                  topologyKey: kubernetes.io/hostname
